{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "maxWarnings": 0
  },
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-perf"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react-perf/jsx-no-new-function-as-prop": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "excludeFiles": ["src/components/ui/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [{
            "group": ["@headlessui/*", "@heroicons/*", "**/ui/*"],
            "message": "Use the public UI adapter at @/components/ui. Keep vendor imports and internal components inside the adapter."
          }]
        }]
      }
    },
    {
      "files": ["src/components/ui/*.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
