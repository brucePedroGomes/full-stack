{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "maxWarnings": 0
  },
  "rules": {
    "react/rules-of-hooks": "error"
  },
  "overrides": [
    {
      "files": ["src/components/ui/*.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
