# Local development only. Copy to .env and use uv run --env-file .env.
DJANGO_DEBUG=true
# Optional: defaults to DJANGO_DEBUG. Enable only on a trusted staging network.
# DJANGO_ENABLE_API_DOCS=true
DJANGO_SECRET_KEY=django-insecure-local-development-only
# Required: generate once with python3 -c 'import secrets; print(secrets.token_hex(32))'
# Paste the value below. Never commit a real pepper or change it casually.
DJANGO_PASSWORD_PEPPER=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# With DJANGO_DEBUG=false, set an SMTP host, sender, and provider options.
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_FROM=challenge@example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USERNAME=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
# Argon2id: processing passes, memory in KiB, and worker threads per hash.
DJANGO_ARGON2_TIME_COST=2
DJANGO_ARGON2_MEMORY_COST=102400
DJANGO_ARGON2_PARALLELISM=8
DB_NAME=challenge
DB_USER=challenge
DB_PASSWORD=local-dev-password
DB_HOST=127.0.0.1
DB_PORT=5439
DB_SSLMODE=disable
