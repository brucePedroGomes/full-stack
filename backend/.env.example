# Copy to .env and fill in the required values.
# These defaults use HTTPS and SMTP.

# Django
# Required: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Host and origin lists use JSON arrays.
DJANGO_ALLOWED_HOSTS='["localhost","127.0.0.1","[::1]"]'

# Security
# Set these explicitly for local HTTP; DEBUG does not change them.
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_CSRF_TRUSTED_ORIGINS='[]'
DJANGO_SECURE_SSL_REDIRECT=true

# PostgreSQL
DB_NAME=challenge
DB_USER=challenge
# Required: choose a password before the first database startup.
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
# Port on your computer; DB_PORT is the container port.
POSTGRES_HOST_PORT=5439

# Redis cache
DJANGO_CACHE_URL=redis://redis:6379/0

# Passwords
# Required: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Generate once. Keep it private and stable.
DJANGO_PASSWORD_PEPPER=
# Argon2 memory is in KiB.
DJANGO_ARGON2_TIME_COST=2
DJANGO_ARGON2_MEMORY_COST=102400
DJANGO_ARGON2_PARALLELISM=8

# API
DJANGO_ENABLE_API_DOCS=false
# Number of trusted reverse proxies.
# DJANGO_NUM_PROXIES=0

# Email
# Required when DJANGO_DEBUG=false.
DJANGO_EMAIL_HOST=
# Required. Use webmaster@localhost for local console email.
DJANGO_EMAIL_FROM=
# Optional SMTP settings. Set username and password together.
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USERNAME=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true

# Celery
# Use a separate Redis database from the cache.
CELERY_BROKER_URL=redis://redis:6379/1
